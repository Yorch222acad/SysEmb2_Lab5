#include <stdint.h>
#include <stdbool.h>
#include "inc/hw_memmap.h"
#include "driverlib/debug.h"
#include "driverlib/gpio.h"
#include "driverlib/sysctl.h"
#include "driverlib/pwm.h"
#include "driverlib/pin_map.h"

#ifdef DEBUG
void _error_(char *pcFilename, uint32_t ui32Line)
{
    while(1);
}
#endif

int main(void)
{
    uint32_t width;
    /////////////////////////////////////////Configuracion de puertos/////////////////////////////////////////////////
    SysCtlPeripheralEnable(SYSCTL_PERIPH_PWM0);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOF);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOH);
    //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    
    
    ///////////////////////////////////////////GPIO//////////////////////////////////////////////////////////////////
    while(!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOH))
    {
    }
    GPIOPinTypeGPIOOutput(GPIO_PORTH_BASE, 0x04);
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    
    
    ////////////////////////////////////////////////Configuracion de PWM///////////////////////////////////////////
    GPIOPinConfigure(GPIO_PF1_M0PWM1);
    GPIOPinTypePWM(GPIO_PORTF_BASE,0x02); // Pin F1 señal de pwm

    PWMGenConfigure(PWM0_BASE, PWM_GEN_0, PWM_GEN_MODE_DOWN | PWM_GEN_MODE_NO_SYNC);
    width = 30000;
    PWMGenPeriodSet(PWM0_BASE, PWM_GEN_0, width);
    PWMGenEnable(PWM0_BASE, PWM_GEN_0);
    PWMOutputState(PWM0_BASE, PWM_OUT_1_BIT, true);
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    while(1){
    width = 0;
    GPIOPinWrite(GPIO_PORTH_BASE, 0x04, 0x04);//PH2 direccion de motor
    for(width=0;width<30000;width++){
        PWMPulseWidthSet(PWM0_BASE, PWM_OUT_1, width);//PWM motor
    }
    for(width=30000;width>0;width--){
        PWMPulseWidthSet(PWM0_BASE, PWM_OUT_1, width);//PWM motor
    	}
    }

}
